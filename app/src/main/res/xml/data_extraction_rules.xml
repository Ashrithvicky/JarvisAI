<?xml version="1.0" encoding="utf-8"?>
<!--
    SECURITY: API 31+ data extraction rules.
    
    This configuration excludes ALL data domains from both cloud backup
    and device-to-device transfer.
    
    Defense-in-depth: This works alongside android:allowBackup="false"
    in the manifest. Even if allowBackup is somehow overridden, these
    rules ensure nothing is extracted.
    
    Domains excluded:
    - sharedpref: All SharedPreferences (including EncryptedSharedPreferences)
    - database: All SQLite databases
    - file: All internal files (models, conversations, memories, encryption data)
    - root: Root of app's file directory tree
    - external: External app-specific storage
    
    NOTHING leaves this device. Ever.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
